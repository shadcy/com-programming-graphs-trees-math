{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++: Build & Run with run.ps1 (Fast OA Runner)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run.ps1",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "C/C++: Build & Run in Terminal (Interactive)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& C:\\msys64\\mingw64\\bin\\g++.exe -std=c++17 -O2 -Wall -Wextra -DLOCAL '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe' ; if ($?) { & '${fileDirname}\\${fileBasenameNoExtension}.exe' }"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "C/C++: Debug Build (for GDB)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& C:\\msys64\\mingw64\\bin\\g++.exe -std=c++17 -g -Wall -Wextra -DLOCAL '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe'"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}

