  "Binary Exponentiation": {
    "prefix": "binpow",
    "body": [
      "ll binpow(ll base, ll exp, ll mod = MOD) {",
      "    ll res = 1;",
      "    base %= mod;",
      "    while (exp > 0) {",
      "        if (exp % 2 == 1) res = (res * base) % mod;",
      "        base = (base * base) % mod;",
      "        exp /= 2;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Fast modular exponentiation O(log N)"
  },
  "Disjoint Set Union (DSU)": {
    "prefix": "dsu",
    "body": [
      "struct DSU {",
      "    vector<int> parent, rank, size;",
      "    DSU(int n) {",
      "        parent.resize(n + 1);",
      "        iota(parent.begin(), parent.end(), 0);",
      "        rank.assign(n + 1, 0);",
      "        size.assign(n + 1, 1);",
      "    }",
      "    int find(int i) {",
      "        if (parent[i] == i) return i;",
      "        return parent[i] = find(parent[i]);",
      "    }",
      "    bool unite(int i, int j) {",
      "        int root_i = find(i);",
      "        int root_j = find(j);",
      "        if (root_i == root_j) return false;",
      "        if (rank[root_i] < rank[root_j]) swap(root_i, root_j);",
      "        parent[root_j] = root_i;",
      "        size[root_i] += size[root_j];",
      "        if (rank[root_i] == rank[root_j]) rank[root_i]++;",
      "        return true;",
      "    }",
      "};"
    ],
    "description": "DSU / Union-Find with path compression and rank"
  },
  "Sieve of Eratosthenes": {
    "prefix": "sieve",
    "body": [
      "vector<bool> is_prime;",
      "vector<int> primes;",
      "void sieve(int n) {",
      "    is_prime.assign(n + 1, true);",
      "    is_prime[0] = is_prime[1] = false;",
      "    for (int p = 2; p * p <= n; p++) {",
      "        if (is_prime[p]) {",
      "            for (int i = p * p; i <= n; i += p)",
      "                is_prime[i] = false;",
      "        }",
      "    }",
      "    for (int p = 2; p <= n; p++) {",
      "        if (is_prime[p]) primes.push_back(p);",
      "    }",
      "}"
    ],
    "description": "Generates primes up to N in O(N log log N)"
  },
